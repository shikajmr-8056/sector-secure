# ─────────────────────────────────────────────────────────────────
# AVSS Frontend — environment variables
# Copy this file to .env.local for local dev (git-ignored).
# In Vercel: set these under Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────

# URL of the AVSS backend API (Express server).
# Local dev: http://localhost:5000
# Production: your Render / Railway / Fly.io deployment URL
# Example: https://avss-backend.onrender.com
VITE_API_URL=http://localhost:5000
